# Core
GITHUB_TOKEN=
GH_TOKEN=
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Neon PostgreSQL and Better Auth
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/DBNAME?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
TRUSTED_PROXIES=
ADMIN_EMAILS=

# Arcjet
ARCJET_KEY=
ARCJET_MODE=disabled
ARCJET_ALLOW_DISABLED_IN_PRODUCTION=false
ARCJET_BOT_ALLOW=CATEGORY:PROGRAMMATIC
ARCJET_FAIL_MODE=local

# Groq LLM (sole LLM provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LLM_MODEL=openai/gpt-oss-120b


# Azure AI Speech (sole STT + TTS provider)
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_RESOURCE_NAME=
AZURE_SPEECH_TIMEOUT_MS=30000
AZURE_SPEECH_MAX_TEXT_CHARS=5000
AZURE_SPEECH_TTS_VOICE_FR=fr-FR-DeniseNeural
AZURE_SPEECH_TTS_VOICE_EN=en-US-JennyNeural
AZURE_SPEECH_TTS_OUTPUT_FORMAT=audio-16khz-128kbitrate-mono-mp3
AUDIO_DEFAULT_LANGUAGE=fr
AUDIO_MAX_UPLOAD_BYTES=20971520

# Billing (unchanged by the audio provider migration)
JEMENIPAY_API_KEY=
JEMENIPAY_SECRET_KEY=
JEMENIPAY_WEBHOOK_SECRET=
JEMENIPAY_ENV=sandbox

# Cloudflare R2
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PRESIGNED_URL_TTL_SECONDS=300
R2_TIMEOUT_MS=30000
UPLOAD_MAX_BYTES=26214400

# Brave Search API (LLM Context)
BRAVE_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_TIMEOUT_MS=30000
BRAVE_SEARCH_MAX_TOKENS=8192
BRAVE_SEARCH_LANGUAGE=fr
BRAVE_SEARCH_COUNTRY=
RESEARCH_MAX_SEARCHES=5
RESEARCH_DEADLINE_MS=60000

# Plans and public pricing (XOF)
# Defaults mirror PlansService and QuotasService; override only after product approval.
PLAN_LIMITS_JSON={"free":{"dailyMessages":20,"monthlyMessages":300,"maxFileBytes":5000000,"maxStorageBytes":50000000,"dailyWebSearches":5,"dailyDeepResearch":1,"dailySpeechChars":5000,"dailyTranscriptions":5,"dailyMathCompute":50},"plus":{"dailyMessages":100,"monthlyMessages":3000,"maxFileBytes":25000000,"maxStorageBytes":500000000,"dailyWebSearches":30,"dailyDeepResearch":5,"dailySpeechChars":30000,"dailyTranscriptions":30,"dailyMathCompute":500},"pro":{"dailyMessages":300,"monthlyMessages":10000,"maxFileBytes":100000000,"maxStorageBytes":5000000000,"dailyWebSearches":100,"dailyDeepResearch":20,"dailySpeechChars":100000,"dailyTranscriptions":100,"dailyMathCompute":2000},"plus_promo":{"dailyMessages":100,"monthlyMessages":1000,"maxFileBytes":25000000,"maxStorageBytes":500000000,"dailyWebSearches":30,"dailyDeepResearch":5,"dailySpeechChars":30000,"dailyTranscriptions":30,"dailyMathCompute":200},"pro_promo":{"dailyMessages":300,"monthlyMessages":3000,"maxFileBytes":100000000,"maxStorageBytes":5000000000,"dailyWebSearches":100,"dailyDeepResearch":20,"dailySpeechChars":100000,"dailyTranscriptions":100,"dailyMathCompute":1000}}
PLAN_PRICES_JSON={"free":0,"plus":5000,"pro":10000,"plus_promo":1500,"pro_promo":3000}
