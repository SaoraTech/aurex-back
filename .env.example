# ───────────── Core ─────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Swagger UI (/docs). Default: on outside production, off in production.
# SWAGGER_ENABLED=false
# Neon pooled connection string. Keep sslmode=require. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/DBNAME?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
# IPs/CIDRs of YOUR reverse proxies / load balancers (comma-separated). Only these may set X-Forwarded-For.
# Empty = the socket address is used (a client cannot spoof its IP). Behind a load balancer you MUST set it,
# otherwise every user shares the balancer's IP for rate limiting.
TRUSTED_PROXIES=
# /api/v1/metrics (Prometheus text) is disabled (404) unless a token is set.
METRICS_TOKEN=

# ───────────── Arcjet (application security) ─────────────
# Get the key from https://app.arcjet.com . Mode: live | dry_run | disabled (default: live if key set, else disabled).
# Production refuses to start without Arcjet unless ARCJET_ALLOW_DISABLED_IN_PRODUCTION=true (not recommended).
ARCJET_KEY=
ARCJET_MODE=
ARCJET_ALLOW_DISABLED_IN_PRODUCTION=false
# Bots allowed through bot detection. Native apps (OkHttp/URLSession) are "programmatic" clients.
ARCJET_BOT_ALLOW=CATEGORY:PROGRAMMATIC
# When Arcjet cannot decide: local = in-process limiter in degraded mode (default); deny = 503 on sensitive routes.
ARCJET_FAIL_MODE=local

# ───────────── Text generation providers ─────────────
AI_TIMEOUT_MS=45000
# Extra providers tried after the first one fails for provider-side reasons (timeout/quota/5xx). 0 disables fallback.
AI_MAX_FALLBACKS=1
# Plus/Pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Free (model IDs configurable; must match your API access)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.ai/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# ───────────── Voice: ElevenLabs (primary) ─────────────
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
# Voice ID chosen server-side (clients cannot override voice or model).
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TIMEOUT_MS=30000
ELEVENLABS_MAX_TEXT_CHARS=5000
AUDIO_DEFAULT_LANGUAGE=fr
AUDIO_MAX_UPLOAD_BYTES=20971520
# STT: primary provider and fallback (Groq Whisper). TTS fallback is opt-in (model availability varies).
AUDIO_STT_PROVIDER=elevenlabs
AUDIO_STT_FALLBACK_PROVIDER=groq
AUDIO_TTS_FALLBACK_PROVIDER=none
# ───────────── Voice: Groq (secondary) — requires GROQ_API_KEY ─────────────
GROQ_SPEECH_ENABLED=false
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI
GROQ_SPEECH_TIMEOUT_MS=30000

# ───────────── Cloudflare R2 (private object storage) ─────────────
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override, e.g. EU jurisdiction: https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Presigned download links: 30..3600 seconds (default 300). The bucket must stay PRIVATE (no public URL, no r2.dev).
R2_PRESIGNED_URL_TTL_SECONDS=300
R2_TIMEOUT_MS=30000
# Hard ceiling for one upload held in memory (plans are capped by it).
UPLOAD_MAX_BYTES=26214400

# ───────────── Tavily (web search / deep research) ─────────────
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=15000
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_CACHE_TTL_SECONDS=600
RESEARCH_MAX_SEARCHES=5
RESEARCH_MAX_EXTRACTS=3
RESEARCH_DEADLINE_MS=60000

# ───────────── Other integrations ─────────────
WOLFRAM_APP_ID=
# Not implemented in this codebase yet (never reported as active): Novu, Resend, payment adapters.
NOVU_API_KEY=
NOVU_APP_IDENTIFIER=
RESEND_API_KEY=
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
# Provisional and configurable; merged field by field over built-in defaults. Not final commercial decisions.
PLAN_LIMITS_JSON={"free":{"dailyMessages":20,"monthlyMessages":300,"maxFileBytes":5000000,"maxStorageBytes":50000000,"dailyWebSearches":5,"dailyDeepResearch":1,"dailySpeechChars":5000,"dailyTranscriptions":5},"plus":{"dailyMessages":100,"monthlyMessages":3000,"maxFileBytes":25000000,"maxStorageBytes":500000000,"dailyWebSearches":30,"dailyDeepResearch":5,"dailySpeechChars":30000,"dailyTranscriptions":30},"pro":{"dailyMessages":300,"monthlyMessages":10000,"maxFileBytes":100000000,"maxStorageBytes":5000000000,"dailyWebSearches":100,"dailyDeepResearch":20,"dailySpeechChars":100000,"dailyTranscriptions":100}}
PLAN_PRICES_JSON={"free":0,"plus":1500,"pro":3000}
