NODE_ENV=development
PORT=3000
# Create a Neon PostgreSQL database and paste its pooled connection string here.
# Keep sslmode=require in the Neon connection string; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/DBNAME?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Plus/Pro text generation providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Free default models (model IDs are configurable and must match the user's enabled API access)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.ai/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# Groq speech endpoints (availability/model names depend on the Groq account/API)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts

WOLFRAM_APP_ID=
NOVU_API_KEY=
NOVU_APP_IDENTIFIER=
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
# Provisional and configurable; not final commercial decisions.
PLAN_LIMITS_JSON={"free":{"dailyMessages":20,"monthlyMessages":300,"maxFileBytes":5000000},"plus":{"dailyMessages":100,"monthlyMessages":3000,"maxFileBytes":25000000},"pro":{"dailyMessages":300,"monthlyMessages":10000,"maxFileBytes":100000000}}
PLAN_PRICES_JSON={"free":0,"plus":1500,"pro":3000}
