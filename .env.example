NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@ep-project.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here_minimum
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# IA Providers (Chat / Raisonnement mathématique)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.ai/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# Audio & Voix (ElevenLabs prioritaire + Groq fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
AUDIO_MAX_FILE_BYTES=25000000
AUDIO_MAX_TTS_CHARS=4000

# Stockage Objet Privé Cloudflare R2 (Compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aurex-private-storage
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Calcul Scientifique & Moteur Mathématique
WOLFRAM_APP_ID=

# Notifications & E-mails (Facultatifs)
NOVU_API_KEY=
NOVU_APP_IDENTIFIER=
RESEND_API_KEY=

# Paiements (Désactivé par défaut jusqu'à validation de l'adaptateur)
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=

# Quotas et Tarifs par Plan
PLAN_LIMITS_JSON={"free":{"dailyMessages":20,"monthlyMessages":300,"maxFileBytes":5000000},"plus":{"dailyMessages":100,"monthlyMessages":3000,"maxFileBytes":25000000},"pro":{"dailyMessages":300,"monthlyMessages":10000,"maxFileBytes":100000000}}
PLAN_PRICES_JSON={"free":0,"plus":1500,"pro":3000}
